# ==============================================================================
# Google AI Studio & Cloud Run Configuration Template
# Copy this file to `.env` and fill in your values. NEVER commit `.env` to Git!
# ==============================================================================

# 1. Google AI Studio API Key (Get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 2. Optional: Google Cloud Project Settings (Required for Module 4 Cloud Run Deploy)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 3. Application Runtime Settings
PORT=8080
RATE_LIMIT_RPM=30
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
